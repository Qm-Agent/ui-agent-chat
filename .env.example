# Execution runtime. Existing selections in the database remain unchanged.
UI_AGENT_DEFAULT_EXECUTION_RUNTIME=dtcoder
# Optional exact executable path when several AiWork distributions coexist.
UI_AGENT_AIWORK_BIN=
# Legacy compatibility alias; prefer UI_AGENT_AIWORK_BIN for new deployments.
UI_AGENT_DTCODER_BIN=
# Legacy compatibility only: optional catalog endpoint for a user-managed CFuse installation.
# Empty disables CFuse remote discovery; public releases default to DTCoder.
CFUSE_MODEL_CATALOG_URL=
# Optional defect tracker adapter. The open-source distribution ships with no
# enabled provider; future Jira/ZenTao adapters can register through this seam.
UIWARDEN_DEFECT_PROVIDER=none

# Optional Anthropic-compatible model profile for Claude Code or an explicitly selected legacy CFuse runtime.
# Set ANTHROPIC_BASE_URL to your Anthropic-compatible API endpoint
# Example: https://your-anthropic-compatible-gateway.example/api/anthropic
ANTHROPIC_BASE_URL=
# Use either ANTHROPIC_AUTH_TOKEN or ANTHROPIC_API_KEY depending on your gateway
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_SMALL_FAST_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=

# Server
PORT=8787
# Bind to loopback by default. Remote access requires an authenticated reverse proxy.
HOST=127.0.0.1
# Optional comma-separated exact origins for clients that cannot use a same-origin proxy.
UI_AGENT_ALLOWED_ORIGINS=
UI_AGENT_DATA_DIR=./data
UI_AGENT_UPLOAD_MAX_FILES=10
UI_AGENT_UPLOAD_MAX_FILE_MB=25
UI_AGENT_UPLOAD_MAX_FIELD_MB=2
UI_TEST_ASSISTANT_SKILL_PATH=
# Web/Docker 部署的托管 gui-browser。默认开启；Chromium 路径留空时从
# PLAYWRIGHT_BROWSERS_PATH 自动发现。桌面客户端继续使用 Electron 内置浏览器。
UI_AGENT_SERVER_MANAGED_BROWSER=true
UIWARDEN_SERVER_BROWSER_EXECUTABLE=
# 通知或外部集成中「查看详情」链接使用的前端 base URL。
# 本地开发留空即可（默认 http://127.0.0.1:8787）；部署到受保护的反向代理后填实际地址。
UI_AGENT_PUBLIC_URL=

# Local SQLite persistence (defaults to <data>/ui-agent-chat.db).
UI_AGENT_DB_MODE=sqlite
UI_AGENT_DB_FILE=

# ─── 巡检/回归并发限流 ───
# 同时执行的巡检任务 + 回归任务数量上限。超过上限的任务进入 FIFO 队列排队。
# 对话任务不受此限制影响。
UI_AGENT_TASK_CONCURRENCY=5
# 单个巡检 run / 回归用例执行超时（毫秒），默认 30 分钟。
# 超时后中止子进程并标记为 failed，释放槽位给队列中下一个任务。
UI_AGENT_TASK_TIMEOUT_MS=1800000
