{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiwarden.local/schemas/native-automation/snapshot-v1.json",
  "title": "UiSnapshot",
  "type": "object",
  "required": ["version", "snapshotId", "sessionId", "sequence", "app", "text", "elements", "delta", "capturedAt"],
  "properties": {
    "version": { "const": 1 },
    "snapshotId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "app": { "type": "object" },
    "text": { "type": "string" },
    "elements": { "type": "array", "items": { "$ref": "protocol-v1.json#/$defs/element" } },
    "projection": {
      "type": "object",
      "required": ["mode", "maxDepth", "maxElements", "truncated"],
      "properties": {
        "mode": { "enum": ["compact", "full"] },
        "maxDepth": { "type": "integer", "minimum": 1 },
        "maxElements": { "type": "integer", "minimum": 1 },
        "truncated": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "windowBounds": { "$ref": "protocol-v1.json#/$defs/bounds" },
    "delta": {
      "type": "object",
      "required": [
        "changed",
        "windowChanged",
        "focusedElementChanged",
        "textChanged",
        "addedElementCount",
        "removedElementCount",
        "updatedElementCount",
        "actionCountSinceLastObservation",
        "noProgressCount"
      ],
      "properties": {
        "changed": { "type": "boolean" },
        "windowChanged": { "type": "boolean" },
        "focusedElementChanged": { "type": "boolean" },
        "textChanged": { "type": "boolean" },
        "addedElementCount": { "type": "integer", "minimum": 0 },
        "removedElementCount": { "type": "integer", "minimum": 0 },
        "updatedElementCount": { "type": "integer", "minimum": 0 },
        "actionCountSinceLastObservation": { "type": "integer", "minimum": 0 },
        "noProgressCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "object",
      "required": ["addedElements", "updatedElements", "removedElementIds"],
      "properties": {
        "addedElements": {
          "type": "array",
          "items": { "$ref": "protocol-v1.json#/$defs/element" }
        },
        "updatedElements": {
          "type": "array",
          "items": { "$ref": "protocol-v1.json#/$defs/element" }
        },
        "removedElementIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "capturedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
