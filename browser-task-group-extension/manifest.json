{
  "manifest_version": 3,
  "name": "UIWarden Browser Bridge",
  "version": "0.9.1",
  "description": "Connects UIWarden to existing Chromium tabs and creates isolated task groups.",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  }
}
