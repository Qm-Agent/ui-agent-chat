{
  "name": "ui-agent-chat",
  "version": "0.12.5",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5174",
    "build": "npm run build:runtimes && npm run build:server && npm run build:client",
    "build:runtimes": "node scripts/build-gui-runtimes.mjs",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "npm run build:runtimes && tsc -p gui-runtime/tsconfig.json --noEmit && tsc -p native-automation/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "tsx --test test/unit/*.test.ts",
    "check:open-source-index": "node scripts/check-open-source-index.mjs",
    "check:open-source-history": "node scripts/check-open-source-history.mjs",
    "check:open-source-build": "node scripts/check-open-source-build.mjs",
    "export:open-source-snapshot": "node scripts/export-open-source-snapshot.mjs",
    "test:open-source-index": "node --test test/scripts/node/open-source-index.test.mjs",
    "test:open-source-builder": "node --test test/scripts/node/open-source-builder-inputs.test.mjs",
    "test:open-source-desktop": "node --test test/scripts/node/open-source-desktop-resources.test.mjs",
    "test:open-source-snapshot": "node --test test/scripts/node/open-source-snapshot.test.mjs",
    "test:open-source-wheel": "python3 -m unittest discover -s test/scripts/python -p test_verify_browser_use_wheel.py",
    "doctor:local": "node scripts/open-source-local.mjs doctor",
    "start:local": "node scripts/open-source-local.mjs start",
    "test:open-source-local": "node --test test/scripts/node/open-source-local.test.mjs",
    "prepare:ui-test-runtime": "node scripts/prepare-ui-test-runtime.mjs",
    "test:browser-schemas": "node test/scripts/node/validate-browser-automation-schemas.mjs",
    "test:browser-runtime": "NODE_PATH=desktop/node_modules desktop/node_modules/.bin/electron test/scripts/node/browser-automation-smoke.cjs",
    "test:pip-runtime": "npm run build && node test/scripts/node/picture-in-picture-smoke.mjs",
    "test:native-pip-stream": "bash native-automation/scripts/build-macos-provider.sh && node test/scripts/node/native-picture-in-picture-stream-smoke.mjs",
    "test:native-background-pip": "bash native-automation/scripts/build-macos-provider.sh && npm run build:runtimes && node test/scripts/node/native-background-picture-in-picture-smoke.mjs",
    "test:gui-runtimes": "npm run build:runtimes && node --test test/scripts/node/gui-runtime-contract.test.mjs && node test/scripts/node/native-automation-smoke.mjs",
    "test:computer-agent": "node test/scripts/node/dt-gui-computer-agent-smoke.mjs",
    "test:runtime-package": "node test/scripts/node/execution-runtime-package-smoke.mjs",
    "gui:release:check": "node scripts/gui-packages.mjs check",
    "gui:release:version": "node scripts/gui-packages.mjs version",
    "gui:release:pack": "node scripts/gui-packages.mjs pack",
    "gui:release:publish": "node scripts/gui-packages.mjs publish",
    "gui:release:verify": "node scripts/gui-packages.mjs verify-registry",
    "browser:start": "npm --prefix gui-computer start",
    "browser:pack:mac": "npm --prefix gui-computer run pack:mac"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^11.8.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "knex": "^3.1.2",
    "lucide-react": "^0.468.0",
    "multer": "2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tar": "^7.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "6.4.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "overrides": {
    "body-parser": "1.20.9"
  }
}
