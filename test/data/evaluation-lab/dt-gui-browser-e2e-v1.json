{
  "schemaVersion": "1.0",
  "id": "dt-gui-browser-e2e-v1",
  "name": "dt-gui-browser 常见能力评测集 v1",
  "description": "首期可执行 Browser Common Bench。已移除尚无 Fixture 支撑的故障注入、企业 Mini App 和机器 Oracle 扩展场景；运行前需在评测页面手动启动目标服务。",
  "targetServices": [
    {
      "id": "browser-common",
      "name": "UIWarden Browser Common Bench",
      "kind": "managed",
      "provider": "uiwarden-browser-common-v1",
      "healthPath": "/_uiwarden/health"
    }
  ],
  "cases": [
    {
      "id": "B01",
      "name": "SPA 路由切换",
      "category": "SPA 路由",
      "compatibleTargets": [
        "browser"
      ],
      "instruction": "打开目标页面。从“复杂表单”切换到“动态表格”，重新观察并确认全局状态和可见区域均为 table。只有验证完成后，最终回复逐字输出结果标记 ROUTE_TABLE_VERIFIED。",
      "targetUrl": "{{targetService:browser-common}}/codex-ui-complex-fixture.html",
      "tags": [
        "browser",
        "core",
        "route",
        "pr-smoke",
        "dt-gui-browser"
      ],
      "timeoutMs": 1800000,
      "passThreshold": 80,
      "enabled": true,
      "assertions": [
        {
          "id": "completed",
          "label": "执行完成",
          "evaluator": "run-completed",
          "weight": 30,
          "required": true,
          "params": {}
        },
        {
          "id": "oracle",
          "label": "路由状态已验证",
          "evaluator": "summary-contains",
          "weight": 50,
          "required": true,
          "params": {
            "terms": [
              "ROUTE_TABLE_VERIFIED"
            ],
            "matchMode": "all"
          }
        },
        {
          "id": "failure",
          "label": "没有失败信号",
          "evaluator": "summary-not-contains",
          "weight": 10,
          "required": true,
          "params": {
            "terms": [
              "无法执行",
              "未验证"
            ],
            "matchMode": "all"
          }
        },
        {
          "id": "artifacts",
          "label": "保留执行证据",
          "evaluator": "artifact-count",
          "weight": 10,
          "required": true,
          "params": {
            "min": 1
          }
        }
      ]
    },
    {
      "id": "B04",
      "name": "复杂组合表单",
      "category": "表单",
      "compatibleTargets": [
        "browser"
