# 模板文件（不含可用凭据）：在本机 config/.env 中设置自己的模型凭据
# Web 容器可通过环境变量注入；不要把实际凭据提交进仓库
# 勿将含真实 Key 的 .env 提交仓库（开源版本不包含任何预设密钥）

## OpenAI-compatible 视觉模型配置
# 填写模型平台控制台给出的 OpenAI-compatible /v1 地址。
# 百炼 Workspace 示例：https://<workspace-host>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BU_OPENAI_API_BASE=
BU_OPENAI_API_KEY=
# 默认采用已验证支持截图理解的百炼公开视觉模型，也可改为其他兼容模型名。
BU_ACTOR_MODEL=qwen3.7-plus
BU_PLANNER_MODEL=qwen3.7-plus
BU_ASSERTER_MODEL=qwen3.7-plus
BU_PAGE_EXTRACTION_LLM=qwen3.7-plus
BU_LOCATING_LLM=qwen3.7-plus
BU_CODING_LLM=qwen3.7-plus
# 视觉模型输出的 box_2d 坐标顺序。Qwen 默认 ltrb；仅在供应商模型明确要求时改为 tlbr。
BU_MODEL_BOX_FORMAT=ltrb


# 快速测试 quick 配置（可选）
# Quick 默认被测站点：任务文本 / --target-url 中有 URL 时以文本为准；否则读 QUICK_URL
QUICK_URL=
# 兼容旧技能变量名：QUICK_TARGET_URL= / TARGET_URL=
# Quick 默认登录凭据：任务文本中有账号/密码时以文本为准；否则优先读取 QUICK_USERNAME / QUICK_PASSWORD
# quick 默认复用本地 CDP Chrome 登录态；未启动时可改用 quick --no-cdp
BU_LOCAL_BROWSER_CDP_URL=http://127.0.0.1:9222
QUICK_USERNAME=
QUICK_PASSWORD=
# quick 自然语言任务文案中勿写 ${USERNAME}/${PASSWORD}（会导致 HTML 报告无法生成）；见 SKILL.md「quick 登录文案与 HTML 报告」
# quick ReAct 最大步数（browser-use 默认 enhanced 模式至少 16；本技能默认 40）
QUICK_MAX_STEPS=40
# quick 失败后 observe + 改写自愈重试次数；默认 1（即总共最多执行 2 轮 quick）
QUICK_MAX_RETRIES=1

# 深度探索 intent_mission 执行器：default=原 YAML Agent；quick=直接 quick；hybrid=原链路失败后 quick fallback（默认）
RECURSIVE_INTENT_EXECUTOR=hybrid
# intent_mission quick/fallback 最大步数；默认复用 QUICK_MAX_STEPS
RECURSIVE_INTENT_QUICK_MAX_STEPS=40
# intent_mission quick/fallback 默认走 CDP；如需 no-cdp 设 true
RECURSIVE_INTENT_QUICK_NO_CDP=false


# 本用例登录（由用户在对话中提供，仅保存在本地 .env）
USERNAME=
PASSWORD=


SENSITIVE_VARIABLES=USERNAME,PASSWORD,QUICK_NAME,QUICK_USERNAME,QUICK_PASSWORD,QUICK_PASSWORK
ANONYMIZED_TELEMETRY=false
BU_CACHE_ENABLED=false
